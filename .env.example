
# Application Configuration
APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=replace_with_a_long_random_secret

# Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=atlas_copilot
DB_USER=atlas_user
DB_PASSWORD=change_me
DB_ROOT_PASSWORD=change_me

# Read-only Database Account
DB_READONLY_USER=atlas_readonly
DB_READONLY_PASSWORD=change_me

# LLM Configuration
LLM_PROVIDER=openai
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
MAX_TOKENS_PER_REQUEST=1000

# Vector Database
CHROMA_PERSIST_DIRECTORY=./chroma_db

# Internal Backend API
ATLAS_API_KEY=replace_with_a_long_random_key
# Placeholder only: set your own strong value in backend/.env; do not use this example value.
ATLAS_WEB_PASSWORD=replace_with_a_separate_long_random_password
ATLAS_WEB_SESSION_TTL_SECONDS=28800
# Optional local testing only. The default excludes synthetic metrics from retrieval.
ATLAS_INCLUDE_SYNTHETIC_METRICS=false
FASTAPI_PORT=8000

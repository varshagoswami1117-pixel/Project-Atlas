
# Application Configuration
APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=replace_with_a_long_random_secret

# Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=atlas_db
DB_USER=atlas_user
DB_PASSWORD=change_me
DB_ROOT_PASSWORD=change_me

# Read-only Database Account
DB_READONLY_USER=atlas_readonly
DB_READONLY_PASSWORD=change_me

# LLM Configuration
LLM_PROVIDER=openai
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
MAX_TOKENS_PER_REQUEST=1000

# Vector Database
CHROMA_PERSIST_DIRECTORY=./chroma_db

# Internal Backend API
BACKEND_API_KEY=replace_with_a_long_random_key
FASTAPI_PORT=8000
